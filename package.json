{
  "name": "pageturner-book-recommendation",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "npm run build && node api/server.js",
    "dev": "concurrently --kill-others \"node api/server.js --port=3001\" \"ng serve --port 4200 --proxy-config proxy.conf.json\"",
    "build": "ng build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit"
  },
  "dependencies": {
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/router": "^22.2.2",
    "rxjs": "~7.8.1",
    "tslib": "^2.6.0",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "concurrently": "^9.2.1",
    "typescript": "~6.0.0"
  }
}
